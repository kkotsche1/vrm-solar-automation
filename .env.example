
# Optional metadata only.
VICTRON_SITE_ID=123456
WEATHER_LATITUDE=39.707337
WEATHER_LONGITUDE=2.791675
WEATHER_TIMEZONE=Europe/Madrid
SUNSHINE_HOURS_MIN=6.5
BATTERY_MIN_SOC_PERCENT=55
BATTERY_SOFT_MIN_SOC_PERCENT=35
# Single hard floor: the daytime automatic cutoff, and the SOC the surplus night
# aims to land on at AUTO_RESUME_START_LOCAL.
BATTERY_HARD_MIN_SOC_PERCENT=22.5
BATTERY_CAPACITY_KWH=50

# Low-battery email thresholds. Each threshold alerts once as SOC falls to it and
# stays latched until SOC recovers past threshold + BATTERY_ALERT_REARM_MARGIN_PERCENT.
BATTERY_ALERT_SOC_PERCENTS=35,25
BATTERY_ALERT_REARM_MARGIN_PERCENT=5

# Night window. With SURPLUS_NIGHT_ENABLED=true this becomes a reserve-aware
# overnight control window instead of a hard forced-off period.
AUTO_OFF_START_LOCAL=18:00
AUTO_RESUME_START_LOCAL=08:00
AUTO_CONTROL_TIMEZONE=Europe/Madrid
# Hold night control until solar actually carries the house rather than until
# AUTO_RESUME_START_LOCAL, which then serves only as the no-sunrise fallback.
AUTO_RESUME_FOLLOWS_CROSSOVER=true
FORECAST_LIBERAL_SUNSHINE_HOURS_MIN=9.0
FORECAST_LIBERAL_SUNSHINE_HOURS_MAX=12.0
SURPLUS_NIGHT_ENABLED=true
SURPLUS_NIGHT_BASE_LOAD_KW=1.25
# Turn-on hysteresis only; it does not raise the morning landing SOC.
SURPLUS_NIGHT_TURN_ON_MARGIN_SOC_PERCENT=10
SURPLUS_NIGHT_MIN_TURN_ON_MARGIN_SOC_PERCENT=7
SURPLUS_NIGHT_NEXT_DAY_SUNSHINE_MIN=9.0
# The pump's draw, used to reserve excess SOC before it may run in the forced-off window.
SURPLUS_NIGHT_PUMP_LOAD_KW=2.1
# A start commits this much compressor run, since it cannot be cancelled once triggered.
SURPLUS_NIGHT_MIN_RUN_HOURS=1.0
# The overnight reserve is budgeted to solar crossover, which is later than
# AUTO_RESUME_START_LOCAL, and base load steps up once the house wakes.
# Crossover is derived from the forecast sunrise, which moves ~2 h across the year here.
# Measured offset on clear September mornings: +58 to +65 min after sunrise.
SURPLUS_NIGHT_CROSSOVER_AFTER_SUNRISE_MINUTES=60
# Used only when the forecast carries no sunrise (API down and nothing cached).
SURPLUS_NIGHT_SOLAR_CROSSOVER_LOCAL=08:15
SURPLUS_NIGHT_MORNING_START_LOCAL=06:00
SURPLUS_NIGHT_MORNING_BASE_LOAD_KW=1.75
# Headroom over BATTERY_HARD_MIN_SOC_PERCENT; the generator trips on sagging voltage, so
# its effective SOC threshold rises with load.
SURPLUS_NIGHT_GENERATOR_MARGIN_SOC_PERCENT=5.0
# Hard forced-off window inside the night. The pump only runs here when there is enough
# SOC to cover the base-load reserve to resume AND the pump draw for the rest of the window.
SURPLUS_NIGHT_FORCED_OFF_START_LOCAL=23:30
SURPLUS_NIGHT_FORCED_OFF_END_LOCAL=03:30

# Daytime solar-surplus override. The adaptive SOC thresholds are blind to production, so
# on a bright morning the overnight reserve lands the battery below the turn-on threshold
# by design and locks the pump out of the best sun of the day. When live solar covers the
# pump's own draw with DAYTIME_SURPLUS_MARGIN_KW to spare, running it charges the battery
# rather than draining it, so the SOC gate is bypassed. The generator-margin floor
# (BATTERY_HARD_MIN_SOC_PERCENT + SURPLUS_NIGHT_GENERATOR_MARGIN_SOC_PERCENT) still applies,
# and the pump draw used is SURPLUS_NIGHT_PUMP_LOAD_KW.
DAYTIME_SURPLUS_TURN_ON_ENABLED=true
DAYTIME_SURPLUS_MARGIN_KW=0.5

# Never *start* the pump while the generator is supplying this much power or more: a start
# would spend generator charge on a compressor run and hold the generator under load. A
# pump already running is left alone, since its compressor cycle is committed. Set to 0
# to disable the guard.
GENERATOR_BLOCK_START_WATTS=100

CERBO_HOST=192.168.68.84
CERBO_PORT=502
CERBO_SITE_NAME=Alaro (Cerbo GX)
CERBO_FETCH_RETRY_COUNT=2
CERBO_FETCH_RETRY_DELAY_SECONDS=1.0
CERBO_UNAVAILABLE_GRACE_CYCLES=10


DATABASE_URL=sqlite:///.state/automation.db
# Set to true for unattended Raspberry Pi timer runs so new schema revisions are applied automatically.
DATABASE_AUTO_MIGRATE=false

SHELLY_HOST=192.168.68.90
SHELLY_PORT=80
SHELLY_SWITCH_ID=0
SHELLY_USE_HTTPS=false


SMTP_GMAIL_SENDER=kkotsche1@gmail.com
SMTP_GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_GMAIL_RECIPIENTS=f.kotschenreuther@yahoo.de,monika_kotschenreuther@yahoo.de,kkotsche1@gmail.com
# Battery SOC alerts are sent once per low-SOC period for 40%, 35%, and 30%, plus one alert when generator power is detected.
