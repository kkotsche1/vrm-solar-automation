[Unit]
Description=ComAp generator Modbus poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kotschi123
Group=kotschi123
WorkingDirectory=/home/kotschi123/vrm-solar-automation
ExecStart=/home/kotschi123/vrm-solar-automation/venv/bin/python -u /home/kotschi123/vrm-solar-automation/scripts/comap_poller.py --host 192.168.68.XXX
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
